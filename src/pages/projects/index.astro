---
import SystemLayout from '../../layouts/SystemLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { projects } from '../../data/projects.js';

const tags = ['all', ...Array.from(new Set(projects.map((p) => p.tag))), 'live demos'];
---

<SystemLayout title="projects · abir deol">
  <SectionHeader variant="projects" eyebrow="a small cluster, each one its own star" title="projects" />

  <div class="filters" role="tablist">
    {tags.map((t, i) => (
      <button class="filter" data-filter={t} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>
    ))}
  </div>

  <ul class="rows row-list">
    {projects.map((p) => (
      <li data-tag={p.tag} data-live={p.live ? 'true' : undefined}>
        <span class="eyebrow tag-label">{p.tag}</span>
        <a href={`/projects/${p.slug}`} class="project-link">
          <strong>{p.name}</strong>{p.live && <span class="live-chip" title="has a live demo that runs in the browser">live</span>}
          <p class="muted">{p.blurb}</p>
        </a>
      </li>
    ))}
  </ul>

  <style>
    .filters {
      display: flex;
      gap: 22px;
      margin-bottom: 28px;
    }
    .filter {
      background: none;
      border: none;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      cursor: pointer;
      padding: 5px 2px;
      border-bottom: 1px solid transparent;
      transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
    }
    .filter:hover { color: var(--fg); }
    .filter[aria-pressed='true'] {
      color: var(--fg);
      border-bottom-color: var(--accent-warm);
    }

    /* borders + hover come from .row-list in theme.css */
    .rows > li {
      display: grid;
      grid-template-columns: 96px 1fr;
      gap: 20px;
    }
    .rows > li[hidden] { display: none; }
    .tag-label {
      padding-top: 5px;
      color: var(--accent-warm);
      opacity: 0.8;
    }
    .project-link strong {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 1.05rem;
      transition: color 0.25s var(--ease);
    }
    .project-link p {
      margin: 6px 0 0;
      font-size: 0.97rem;
      max-width: 60ch;
    }
    .live-chip {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      border: 1px solid var(--accent-edge);
      background: var(--accent-soft);
      border-radius: 999px;
      padding: 1px 7px;
      margin-left: 10px;
      vertical-align: 3px;
    }
    .filters { flex-wrap: wrap; row-gap: 8px; }
    .project-link:hover strong,
    .project-link:focus-visible strong { color: var(--accent-warm); }
  </style>

  <script is:inline>
    (function () {
      var buttons = document.querySelectorAll('.filter');
      var items = document.querySelectorAll('.rows > li');
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].addEventListener('click', function (e) {
          var btn = e.currentTarget;
          // Keep the choice in the URL, so a filtered list can be linked to.
          var f = btn.getAttribute('data-filter');
          var url = new URL(location.href);
          if (f === 'all') url.searchParams.delete('filter');
          else url.searchParams.set('filter', f === 'live demos' ? 'live' : f);
          history.replaceState(null, '', url);
          for (var j = 0; j < buttons.length; j++) buttons[j].setAttribute('aria-pressed', 'false');
          btn.setAttribute('aria-pressed', 'true');
          var filter = btn.getAttribute('data-filter');
          for (var k = 0; k < items.length; k++) {
            var li = items[k];
            li.hidden = filter === 'live demos'
              ? li.getAttribute('data-live') !== 'true'
              : filter !== 'all' && li.getAttribute('data-tag') !== filter;
          }
        });
      }
      // ?filter=live (linked from every demo) or ?filter=<tag> preselects a filter.
      var wanted = new URLSearchParams(location.search).get('filter');
      if (wanted) {
        var target = wanted === 'live' ? 'live demos' : wanted;
        for (var j = 0; j < buttons.length; j++) {
          if (buttons[j].getAttribute('data-filter') === target) buttons[j].click();
        }
      }
    })();
  </script>
</SystemLayout>
