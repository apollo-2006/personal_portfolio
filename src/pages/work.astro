---
import SystemLayout from '../layouts/SystemLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<SystemLayout title="work · abir deol">
  <SectionHeader variant="work" eyebrow="where I've spent my time" title="work" />

  <ul class="rows row-list">
    <li>
      <div>
        <strong>university of alberta</strong>
        <p class="muted">bsc computing science</p>
      </div>
      <span class="eyebrow">graduating 2028</span>
    </li>
  </ul>

  <style>
    /* layout only. borders, hover, and type come from .row-list in theme.css */
    .rows > li {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
    }
    .rows .eyebrow {
      flex: none;
      padding-top: 4px;
      color: var(--accent-warm);
      opacity: 0.85;
    }
  </style>
</SystemLayout>
