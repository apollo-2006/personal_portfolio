---
import SystemLayout from '../layouts/SystemLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { contributions, contributionStats } from '../data/contributions.js';
import { projects } from '../data/projects.js';
import { postmortems } from '../data/postmortems.js';

// the five projects that best show range: distributed systems, storage,
// allocators, graphics, and a shipped browser demo. the rest are one click away.
const featuredSlugs = [
  'oracle-of-delphi',
  'nexus-cluster',
  'custom-mem-alloc',
  'cpu-rasterizer',
  'nexus-db',
];
const featured = featuredSlugs
  .map((s) => projects.find((p) => p.slug === s))
  .filter(Boolean);

const { repos, prs, issues, merged, approved } = contributionStats;

// the honest line about status. derived, because the previous hardcoded version
// ("none of these are merged yet") silently became false the day one landed.
const numeral = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven'];
const num = (n) => numeral[n] ?? String(n);
const approvedClause =
  approved === 0 ? '' : `, and ${num(approved)} more ${approved === 1 ? 'is' : 'are'} approved`;
const statusLine =
  merged === 0
    ? approved === 0
      ? 'all of it is still open. none of these are merged yet.'
      : `none of these are merged yet, but ${num(approved)} ${approved === 1 ? 'is' : 'are'} approved. the rest are still open.`
    : `${num(merged)} of the ${num(prs)} pull requests ${merged === 1 ? 'is' : 'are'} merged upstream${approvedClause}. the rest are still open.`;
const statusOf = (c) => (c.pr ? (c.pr.state === 'merged' ? 'merged' : 'open') : 'issue');
const counts = { all: contributions.length, merged: 0, open: 0, issue: 0 };
for (const c of contributions) counts[statusOf(c)]++;
---

<SystemLayout
  title="work · abir deol"
  description={`Open-source contributions to the Vulkan validation layers, Mesa, whisper.cpp, llama.cpp, lemonade, candle, tokenizers and espeak-ng, ${projects.length} systems projects, and written post-mortems. Abir Deol, computing science at the University of Alberta.`}
>
  <SectionHeader variant="work" eyebrow="the short version, in one page" title="work" />

  <p class="intro">
    third-year computing science at the university of alberta. I build systems from the bottom up and
    write down what breaks. everything below links to the real code or thread.
  </p>

  <!-- ============ open source ============ -->
  <h2 class="sub-heading">open source</h2>
  <!-- astro trims whitespace where a text line meets a tag across a newline,
       so every gap next to an inline element here is either on the same line
       or an explicit {' '}. breaking before a tag silently joins the words. -->
  <p class="section-note">
    {prs} pull requests and {issues} issues across {repos} projects, most of them crashes and missing
    validation I found and fixed myself.{' '}
    <strong class="honest">{statusLine}</strong>
  </p>

  <div class="filters" role="group" aria-label="filter contributions">
    <button type="button" class="filter is-on" data-filter="all">all <span>{counts.all}</span></button>
    <button type="button" class="filter" data-filter="merged">merged <span>{counts.merged}</span></button>
    <button type="button" class="filter" data-filter="open">open <span>{counts.open}</span></button>
    <button type="button" class="filter" data-filter="issue">issues <span>{counts.issue}</span></button>
  </div>

  <ul class="rows row-list contrib-list">
    {contributions.map((c) => (
      <li class={c.lead ? 'is-lead' : ''} data-status={statusOf(c)}>
        <div class="contrib-head">
          <span class="eyebrow repo-label">{c.org}/{c.project}</span>
          <span class={`chip kind-${c.kind === 'issue' ? 'issue' : 'pr'}`}>{c.kind}</span>
          {c.merged && <span class="chip merged-chip">merged</span>}
          {c.diff && <span class="eyebrow diff">{c.diff}</span>}
          <span class="eyebrow when">{c.date}</span>
        </div>

        <strong>{c.title}</strong>
        <p class="muted">{c.short}</p>

        <details class="more">
          <summary>how it went</summary>
          <p class="muted full">{c.summary}</p>
          {c.detail.length > 0 && (
            <ul class="detail">
              {c.detail.map((d) => <li>{d}</li>)}
            </ul>
          )}
        </details>

        {c.note && <p class="note">{c.note}</p>}

        <div class="links">
          {c.issue && (
            <a href={c.issue.url} target="_blank" rel="noopener">
              issue #{c.issue.number} <span class="state">{c.issue.state}</span>
            </a>
          )}
          {c.pr && (
            <a href={c.pr.url} target="_blank" rel="noopener">
              pr #{c.pr.number} <span class={c.pr.state === 'merged' ? 'state is-merged' : 'state'}>{c.pr.state}{c.pr.review === 'approved' && c.pr.state === 'open' && ' · approved'}</span>
            </a>
          )}
          {c.companion && (
            <a href={c.companion.url} target="_blank" rel="noopener">
              pr #{c.companion.number} <span class={c.companion.state === 'merged' ? 'state is-merged' : 'state'}>{c.companion.state}</span>
            </a>
          )}
          {c.stack.map((s) => <span class="chip stack-chip">{s}</span>)}
        </div>
      </li>
    ))}
  </ul>

  <!-- ============ projects ============ -->
  <h2 class="sub-heading">selected projects</h2>
  <p class="section-note">
    five of {projects.length}. <a href="/projects">all projects →</a>
  </p>

  <ul class="rows row-list">
    {featured.map((p) => (
      <li>
        <span class="eyebrow repo-label">{p.tag}</span>
        <a href={`/projects/${p.slug}`} class="row-link">
          <strong>{p.name}</strong>
          <p class="muted">{p.blurb}</p>
        </a>
        <div class="links">
          {p.stack.map((s) => <span class="chip stack-chip">{s}</span>)}
        </div>
      </li>
    ))}
  </ul>

  <!-- ============ writing ============ -->
  <h2 class="sub-heading">writing</h2>
  <p class="section-note">
    one post-mortem per bug that actually cost me something. <a href="/research">all writing →</a>
  </p>

  <ul class="rows row-list">
    {postmortems.slice(0, 3).map((pm) => (
      <li>
        <a href={`/research/${pm.slug}`} class="row-link">
          <strong>{pm.title}</strong>
          {pm.blurb && <p class="muted">{pm.blurb}</p>}
        </a>
      </li>
    ))}
  </ul>

  <!-- ============ education ============ -->
  <h2 class="sub-heading">education</h2>
  <ul class="rows row-list">
    <li class="edu-row">
      <div>
        <strong>university of alberta</strong>
        <p class="muted">bsc computing science</p>
      </div>
      <span class="eyebrow">graduating 2028</span>
    </li>
  </ul>

  <p class="closing">
    <a class="cta" href="/abir-deol-resume.pdf" target="_blank" rel="noopener">resume (pdf)</a>
    <a class="cta" href="/connect">get in touch</a>
  </p>

  <style>
    .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 6px; }
    .filter {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      letter-spacing: 0.04em;
      color: var(--muted);
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 5px 12px;
      cursor: pointer;
      transition: color 0.2s var(--ease), border-color 0.2s var(--ease), background 0.2s var(--ease);
    }
    .filter span { opacity: 0.6; margin-left: 4px; }
    .filter:hover, .filter:focus-visible { color: var(--fg); border-color: var(--accent-edge); }
    .filter.is-on { color: var(--accent-warm); border-color: var(--accent-warm); background: var(--warm-soft); }
    .more { margin: 8px 0 4px; }
    .more .full { margin: 6px 0 0; }
    .more summary {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      letter-spacing: 0.04em;
      color: var(--accent);
      cursor: pointer;
      width: fit-content;
    }
    .more[open] summary { margin-bottom: 4px; }

    .intro {
      max-width: 68ch;
      margin: 0 0 42px;
      color: var(--muted);
      line-height: 1.7;
    }
    .section-note {
      max-width: 68ch;
      margin: 0 0 18px;
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.65;
    }
    .section-note a { color: var(--accent-warm); }
    .honest { color: var(--fg); font-weight: 500; }

    /* .sub-heading ships with bottom margin only; these stack as repeated
       section breaks down one page, so they need the space above too. */
    .sub-heading { margin-top: 56px; }
    .sub-heading + .section-note { margin-top: -8px; }

    /* wide screens: the list breaks out of the reading column into a card
       grid, since 29 entries in one narrow column is a lot of scrolling */
    @media (min-width: 1000px) {
      .filters,
      .contrib-list {
        position: relative;
        left: 50%;
        transform: translateX(-50%);
        width: min(1240px, calc(100vw - 96px));
      }
      .contrib-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        align-items: start;
        margin-top: 10px;
      }
      .contrib-list > li,
      .contrib-list > li:hover,
      .contrib-list > li:focus-within {
        padding: 16px 18px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(13, 19, 29, 0.72);
      }
      .contrib-list > li:last-child { border-bottom: 1px solid var(--line); }
      .contrib-list > li:hover,
      .contrib-list > li:focus-within { border-color: var(--accent-edge); }
      .contrib-list > li.is-lead { border-left: 1px solid var(--line); box-shadow: inset 2px 0 0 var(--accent-warm); }
      .contrib-list > li[hidden] { display: none; }
      .contrib-list strong { font-size: 0.98rem; }
      .contrib-list p.muted { font-size: 0.9rem; line-height: 1.6; }
      .contrib-list .links { margin-top: 10px; }
    }
    @media (min-width: 1440px) {
      .contrib-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    /* contributions ------------------------------------------------ */
    .contrib-head {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 8px;
    }
    .repo-label { color: var(--accent-warm); opacity: 0.85; }
    .diff,
    .when { color: var(--muted); opacity: 0.75; }
    .when { margin-left: auto; }

    /* the shared .chip is sized for stack tags; these are inline status
       markers next to the repo name, so they need to be smaller. */
    .kind-pr,
    .kind-issue,
    .merged-chip {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 3px 8px;
    }

    /* merged is the only status worth colour on this page; everything else
       reads as in-flight and stays muted. */
    .merged-chip {
      color: var(--accent-warm);
      border-color: var(--accent-warm);
      background: transparent;
    }
    .stack-chip { font-size: 0.66rem; padding: 4px 9px; }

    /* the two issue -> pr loops carry the most signal, so they get the rail */
    .contrib-list > li.is-lead { border-left-color: var(--accent-edge); }

    .detail {
      margin: 10px 0 0;
      padding-left: 18px;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.65;
    }
    .detail li { margin-bottom: 6px; }
    .detail li:last-child { margin-bottom: 0; }

    .note {
      margin: 10px 0 0;
      font-size: 0.84rem;
      color: var(--muted);
      opacity: 0.85;
      font-style: italic;
    }

    .links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-top: 14px;
    }
    .links > a {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent-warm);
      border-bottom: 1px solid transparent;
      transition: border-color 0.25s var(--ease);
    }
    .links > a:hover { border-bottom-color: var(--accent-warm); }
    .state {
      color: var(--muted);
      opacity: 0.7;
      text-transform: uppercase;
      font-size: 0.65rem;
      letter-spacing: 0.08em;
    }
    .state.is-merged { color: var(--accent-warm); opacity: 1; }

    .row-link strong { transition: color 0.25s var(--ease); }
    .row-link:hover strong,
    .row-link:focus-visible strong { color: var(--accent-warm); }

    .edu-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
    }
    .edu-row .eyebrow {
      flex: none;
      padding-top: 4px;
      color: var(--accent-warm);
      opacity: 0.85;
    }

    .closing {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin: 46px 0 0;
    }
    .cta {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      padding: 10px 18px;
      border: 1px solid var(--line);
      border-radius: 4px;
      color: var(--fg);
      transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
    }
    .cta:hover {
      border-color: var(--accent-warm);
      color: var(--accent-warm);
    }

    @media (max-width: 640px) {
      .when { margin-left: 0; }
      .edu-row { flex-direction: column; gap: 6px; }
    }
  </style>
<script>
  const buttons = document.querySelectorAll('.filter');
  const items = document.querySelectorAll('.contrib-list > li');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.classList.toggle('is-on', x === b));
      const f = b.dataset.filter;
      items.forEach((li) => (li.hidden = f !== 'all' && li.dataset.status !== f));
    })
  );
</script>
</SystemLayout>
