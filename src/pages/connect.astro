---
import SystemLayout from '../layouts/SystemLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<SystemLayout title="connect · abir deol">
  <SectionHeader variant="connect" eyebrow="a signal back" title="connect" />
  <p class="lede">always up for talking systems, flight, or the gym.</p>
  <div class="links">
    <a href="mailto:abir.deol2006@gmail.com">email</a>
    <a href="https://github.com/apollo-2006" target="_blank" rel="noopener">github</a>
    <a href="https://www.linkedin.com/in/abirdeol/" target="_blank" rel="noopener">linkedin</a>
  </div>

  <style>
    .lede { max-width: 48ch; font-size: 1.04rem; }
    .links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
      font-family: var(--font-mono);
      font-size: 0.86rem;
    }
    /* each link is a node: a star, a label, a lit border on hover */
    .links a {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      border: 1px solid var(--line);
      border-radius: 4px;
      transition:
        border-color 0.28s var(--ease),
        background 0.28s var(--ease),
        color 0.28s var(--ease);
    }
    .links a::before {
      content: '';
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--accent-warm);
      box-shadow: 0 0 6px 1px var(--accent-warm);
      transition: transform 0.28s var(--ease);
    }
    .links a:hover,
    .links a:focus-visible {
      color: var(--fg);
      border-color: var(--accent-edge);
      background: var(--accent-soft);
    }
    .links a:hover::before { transform: scale(1.5); }
  </style>
</SystemLayout>
