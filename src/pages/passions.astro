---
import SystemLayout from '../layouts/SystemLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { passions } from '../data/passions.js';

// apollo is a bespoke page rather than a data entry, so it is appended here
const entries = [
  ...passions.map((p) => ({
    name: p.name,
    blurb: p.blurb,
    eyebrow: p.eyebrow,
    href: `/passions/${p.slug}`,
  })),
  {
    name: 'apollo',
    blurb: 'the lyre, the bow, and why he is the idol. the myth behind the handle.',
    eyebrow: 'the name',
    href: '/passions/apollo',
  },
];
---

<SystemLayout title="passions · abir deol">
  <SectionHeader
    variant="passions"
    eyebrow="the things I keep coming back to"
    title="passions"
  />

  <p class="intro">
    most of these are the same thing wearing different clothes: pick something hard,
    do it badly, keep showing up until you don't. the gym taught me that one first and
    everything else inherited it.
  </p>

  <ul class="rows row-list">
    {entries.map((e) => (
      <li>
        <span class="eyebrow tag-label">{e.eyebrow}</span>
        <a href={e.href} class="passion-link">
          <strong>{e.name}</strong>
          <p class="muted">{e.blurb}</p>
        </a>
      </li>
    ))}
  </ul>

  <style>
    .intro {
      max-width: 62ch;
      margin: -18px 0 34px;
      color: var(--fg);
      font-size: 1.04rem;
    }
    /* borders and hover come from .row-list in theme.css */
    .rows > li {
      display: grid;
      grid-template-columns: 168px 1fr;
      gap: 20px;
    }
    .tag-label {
      padding-top: 5px;
      color: var(--accent-warm);
      opacity: 0.8;
    }
    .passion-link strong {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 1.05rem;
      transition: color 0.25s var(--ease);
    }
    .passion-link p {
      margin: 6px 0 0;
      font-size: 0.97rem;
      max-width: 60ch;
    }
    .passion-link:hover strong,
    .passion-link:focus-visible strong { color: var(--accent-warm); }

    @media (max-width: 620px) {
      .rows > li { grid-template-columns: 1fr; gap: 4px; }
      .tag-label { padding-top: 0; }
    }
  </style>
</SystemLayout>
