---
import SystemLayout from '../layouts/SystemLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { passions } from '../data/passions.js';

// apollo is a bespoke page rather than a data entry, so it is appended here
const entries = [
  ...passions.map((p) => ({
    name: p.name,
    blurb: p.blurb,
    eyebrow: p.eyebrow,
    href: `/passions/${p.slug}`,
  })),
  {
    name: 'apollo',
    blurb: 'the lyre, the bow, and why he is the idol. the myth behind the handle.',
    eyebrow: 'the name',
    href: '/passions/apollo',
  },
];
---

<SystemLayout title="passions · abir deol">
  <SectionHeader
    variant="passions"
    eyebrow="the things I keep coming back to"
    title="passions"
  />

  <p class="intro">
    most of these are the same thing wearing different clothes: pick something hard,
    do it badly, keep showing up until you don't. the gym taught me that one first and
    everything else inherited it.
  </p>

  <ul class="cards three wide">
    {entries.map((e) => (
      <li>
        <a href={e.href} class="card-link">
          <span class="eyebrow card-eyebrow">{e.eyebrow}</span>
          <strong>{e.name}</strong>
          <p class="muted">{e.blurb}</p>
        </a>
      </li>
    ))}
  </ul>

  <style>
    .intro {
      max-width: 62ch;
      margin: -18px 0 34px;
      color: var(--fg);
      font-size: 1.04rem;
    }
  </style>
</SystemLayout>
