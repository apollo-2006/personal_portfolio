---
import SystemLayout from '../layouts/SystemLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<SystemLayout title="passions — abir deol">
  <SectionHeader variant="passions" eyebrow="what I do when I'm not building" title="passions" />

  <ul class="rows">
    <li>
      <div>
        <strong>lifting</strong>
        <p class="muted">6 days a week, push/pull/legs — chasing PRs, tracking every macro.</p>
      </div>
    </li>
    <li>
      <div>
        <strong>gaming</strong>
        <p class="muted">
          apex legends is the main one — plat 2, maining wattson and alter. valorant enough
          that I built a stat tracker for it, and enough fps generally that I ended up writing
          my own barebones shooter to see how the genre works from the inside.
        </p>
      </div>
    </li>
    <li>
      <div>
        <strong>building projects</strong>
        <p class="muted">
          mostly low-level things, to find out what the abstraction is hiding — a memory
          allocator instead of malloc, a virtual machine instead of an interpreter, a
          raytracer and a software rasterizer instead of a graphics api. plus a distributed
          key-value store running raft, and an hft matching engine built for latency.
          a habit-tracking app with a friend of 15 years is still in use.
        </p>
      </div>
    </li>
    <li>
      <a href="/passions/apollo" class="myth-link">
        <strong>apollo</strong>
        <p class="muted">the lyre, the sun, and why he's the idol — the myth behind the handle.</p>
      </a>
    </li>
  </ul>

  <style>
    .rows {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
    }
    .rows > li {
      padding: 18px 0;
      border-bottom: 1px solid var(--line);
    }
    .rows > li:last-child { border-bottom: none; }
    .rows strong { font-family: var(--font-display); font-weight: 500; }
    .rows p { margin: 4px 0 0; }
    .myth-link { display: block; }
    .myth-link:hover strong { color: var(--accent); }
  </style>
</SystemLayout>
