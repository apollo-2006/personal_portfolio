---
import SystemLayout from '../layouts/SystemLayout.astro';
import ConstellationGlyph from '../components/ConstellationGlyph.astro';
import { projects } from '../data/projects.js';

// scattered constellation, positioned by top/left percentages (this is the
// pattern from the original design that rendered correctly; the entrance
// animation keyframes bake in the -50%,-50% centering translate, so the
// two never fight over the same transform).
// order doubles as the traversal path: each star links to the next, looping.
// APOLLO'S BOW: five stars trace the limb from top tip to bottom tip; the
// bowstring is the wrap-around segment from the last star back to the first,
// so it costs no extra stars. the grip (max bulge) is the anchor position.
// to reshape: these five top/left pairs are the only thing you need to touch.
const stars = [
  { href: '/research', variant: 'research', label: 'research', desc: 'learning ml, writing it down', top: 10, left: 32 },
  { href: '/passions', variant: 'passions', label: 'passions', desc: 'gym · mma · gaming · reading', top: 30, left: 62 },
  { href: '/projects', variant: 'projects', label: 'projects', desc: '15 systems, built raw', top: 49, left: 72 },
  { href: '/work', variant: 'work', label: 'work', desc: 'u of a · grad 2028', top: 68, left: 62 },
  { href: '/connect', variant: 'connect', label: 'connect', desc: 'say hello', top: 88, left: 32 },
];

// what each star expands into when clicked: the orbiting sub-nodes.
// an empty list means a click navigates straight to the page (research).
const subItems = {
  work: [
    { label: 'u of a', desc: 'bsc computing science, graduating 2028', href: '/work' },
  ],
  // each passion is its own sub-page now; feature 5 and link out to the rest
  passions: [
    { label: 'lifting', desc: '6x a week, push/pull/legs', href: '/passions/lifting' },
    { label: 'mma', desc: 'two-time national champion', href: '/passions/mma' },
    { label: 'gaming', desc: 'apex plat · valorant diamond', href: '/passions/gaming' },
    { label: 'building things', desc: 'allocators, vms, raytracers', href: '/passions/building' },
    { label: 'apollo', desc: 'the myth behind the name', href: '/passions/apollo' },
    { label: 'all 7 →', desc: 'reading, basketball, the rest', href: '/passions' },
  ],
  // 15 repos is too many to orbit legibly, so feature 5, then link out to the rest
  projects: [
    ...projects
      .filter((p) => ['nexus-cluster', 'nano-match', 'custom-mem-alloc', 'neon-vm', 'photon-tracer'].includes(p.slug))
      .map((p) => ({ label: p.name, desc: p.blurb, href: `/projects/${p.slug}` })),
    { label: `all ${projects.length} →`, desc: 'the full cluster', href: '/projects' },
  ],
  connect: [
    { label: 'email', desc: 'abir.deol2006@gmail.com', href: 'mailto:abir.deol2006@gmail.com' },
    { label: 'github', desc: 'source, repos', href: 'https://github.com/apollo-2006' },
    { label: 'linkedin', desc: 'the professional signal', href: 'https://www.linkedin.com/in/abirdeol/' },
  ],
  research: [
    { label: 'the paper', desc: 'learning cv from the pixels up', href: '/research' },
  ],
};
---

<SystemLayout title="abir deol · personal portfolio" fullBleed>
  <div class="field" id="field">
    <div class="zoom-scrim"></div>

    <!-- constellation lines: plain divs sized/rotated in real pixels by JS.
         no SVG viewBox, so nothing gets stretched at wide/narrow aspect
         ratios: a line is a line and a dot is a dot on every screen. -->
    <div class="lines" id="lines" aria-hidden="true">
      {stars.map((s, i) => (
        <div class={`line${i === stars.length - 1 ? ' bowstring' : ''}`} data-a={i} data-b={(i + 1) % stars.length}>
          <span class="line-dot" style={`animation-delay:${i * 1.1}s`}></span>
        </div>
      ))}
    </div>

    <!-- shootable bowstring: an svg for the bent string while drawing,
         an invisible grab strip laid along the straight string, and the
         arrow that flies on release -->
    <svg class="bow-draw" id="bowDraw" aria-hidden="true">
      <path id="bowDrawPath" d="" />
      <circle id="bowNock" r="3" />
    </svg>
    <div class="bow-grip" id="bowGrip" aria-hidden="true"></div>
    <div class="bow-arrow" id="bowArrow" aria-hidden="true"></div>

    {stars.map((s, i) => (
      <a
        class="star"
        href={s.href}
        data-key={s.variant}
        data-idx={i}
        data-top={s.top}
        data-left={s.left}
        data-has-children={subItems[s.variant].length > 0 ? 'true' : 'false'}
        style={`--i:${i}; top:${s.top}%; left:${s.left}%; animation-delay:${i * 0.28}s, ${1.2 + i * 0.6}s, ${3 + i}s;`}
      >
        <span class="star-pull">
          <ConstellationGlyph variant={s.variant} size={52} />
          <span class="star-label">{s.label}</span>
          <span class="star-desc">{s.desc}</span>
          <span class="enter-hint">click again to enter →</span>
        </span>
      </a>
    ))}

    {stars.map((s) => {
      const items = subItems[s.variant];
      const radius = items.length > 4 ? 230 : items.length > 1 ? 180 : 130;
      return (
        <div class="orbit" data-orbit={s.variant} data-radius={radius} style={`--r:${radius}px;`}>
          {items.map((item, j) => {
            const angle = (360 / items.length) * j - 90;
            const external = item.href.startsWith('http') || item.href.startsWith('mailto:');
            return (
              <a
                class="sub-node"
                href={item.href}
                tabindex="-1"
                style={`--angle:${angle}deg; --i:${j};`}
                target={external && item.href.startsWith('http') ? '_blank' : undefined}
                rel={external && item.href.startsWith('http') ? 'noopener' : undefined}
              >
                <span class="sub-dot"></span>
                <span class="sub-label">{item.label}</span>
                <span class="sub-desc">{item.desc}</span>
              </a>
            );
          })}
        </div>
      );
    })}
  </div>

  <div class="hero-text">
    <p class="eyebrow">computing science · university of alberta</p>
    <h1>abir deol</h1>
    <p class="alias">apollo</p>
    <p class="drift">you've drifted into the void</p>
    <p class="lede">click a star to explore. <span class="lede-hint">or draw the bowstring and let go.</span></p>
  </div>

  <button class="exit-void" type="button" aria-label="back to the void">↺ back to the void</button>

  <noscript>
    <style>
      .star { opacity: 1 !important; animation: none !important; }
    </style>
  </noscript>

  <style>
    .field {
      position: absolute;
      inset: 0;
      will-change: transform;
    }
    .zoom-scrim {
      position: absolute;
      inset: 0;
      z-index: 2;
      background: var(--bg);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.45s var(--ease);
    }
    :global(main.full-bleed.zoomed) .zoom-scrim { opacity: 0.85; }

    .lines {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
    }
    .line {
      position: absolute;
      height: 1px;
      width: 0;
      background: var(--accent);
      opacity: 0.45;
      transform-origin: 0 50%;
      transition: opacity 0.4s var(--ease), background 0.4s var(--ease), box-shadow 0.4s var(--ease);
    }
    /* the travelling dot only makes sense once its line has been drawn */
    .line-dot { opacity: 0; transition: opacity 0.5s var(--ease); }
    :global(main.full-bleed.intro-done) .line-dot { opacity: 1; }
    :global(main.full-bleed.intro-done) .line.bowstring .line-dot { opacity: 0.55; }
    .line-dot {
      position: absolute;
      top: 50%;
      left: 0%;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--star);
      transform: translate(-50%, -50%);
      filter: drop-shadow(0 0 2px var(--accent));
      animation: travel 7s linear infinite;
    }
    @keyframes travel {
      from { left: 0%; }
      to { left: 100%; }
    }
    /* the bowstring: finer and cooler than the limb, so the shape reads as
       a bow rather than a closed polygon */
    .line.bowstring {
      opacity: 0.28;
      background: var(--accent-warm);
    }
    .line.bowstring .line-dot { opacity: 0.55; }

    /* line illumination: hovering a star lights the two lines touching it */
    .line.lit {
      opacity: 1;
      background: var(--accent-warm);
      box-shadow: 0 0 5px 1px var(--accent-warm);
      animation: line-throb 1.1s ease-in-out infinite;
    }
    .line.lit .line-dot { filter: drop-shadow(0 0 4px var(--accent-warm)); }
    @keyframes line-throb {
      0%, 100% { box-shadow: 0 0 3px 0px var(--accent-warm); }
      50% { box-shadow: 0 0 8px 2px var(--accent-warm); }
    }

    .hero-text {
      position: absolute;
      top: 100px;
      left: clamp(20px, 4vw, 48px);
      max-width: 340px;
      z-index: 3;
      transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
    }
    .hero-text h1 {
      font-size: clamp(2.6rem, 6vw, 4.2rem);
      line-height: 1.02;
      letter-spacing: -0.03em;
      margin: 10px 0 0;
    }
    .alias {
      font-family: var(--font-mono);
      font-size: clamp(0.8rem, 1.4vw, 0.95rem);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent-warm);
      margin: 6px 0 0;
    }
    .drift {
      font-family: var(--font-display);
      font-size: clamp(1rem, 1.8vw, 1.2rem);
      color: var(--fg);
      margin: 18px 0 10px;
    }
    .lede { color: var(--muted); }

    .star {
      position: absolute;
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      transform: translate(-50%, -50%);
      opacity: 0;
    }
    /* entrance waits for the JS boot signal: CSS delays and the JS line
       timer then share one time origin, so the rhythm can't drift, and the
       first stars can't be eaten by page-load jank */
    :global(main.full-bleed.booted) .star {
      animation-name: star-in, float, twinkle;
      animation-timing-function: var(--ease), ease-in-out, ease-in-out;
      animation-iteration-count: 1, infinite, infinite;
      animation-fill-mode: forwards, none, none;
      animation-duration: 0.55s, 6s, 4s;
    }
    /* the entrance keyframes bake the centering translate in, so the
       animation and the base transform agree (see note at top) */
    @keyframes star-in {
      0%   { opacity: 0; transform: translate(-50%, -50%) scale(0.3); filter: brightness(2.2); }
      55%  { opacity: 1; transform: translate(-50%, -50%) scale(1.14); filter: brightness(1.9); }
      100% { opacity: 1; transform: translate(-50%, -50%) scale(1); filter: brightness(1); }
    }
    @keyframes float {
      0%, 100% { margin-top: 0; }
      50% { margin-top: -8px; }
    }
    @keyframes twinkle {
      0%, 100% { filter: brightness(0.85); }
      50% { filter: brightness(1.15); }
    }

    /* JS drives this inner span's transform (gravitational pull + zoom),
       so it never fights the keyframe animation on .star above */
    .star-pull {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      transform: translate(0, 0) scale(1);
    }

    /* target ring: the "this is a button" affordance. hidden during
       assembly, revealed once the constellation is complete, so the rings
       read as the interface switching on. */
    .star-pull::before {
      content: '';
      position: absolute;
      top: 26px;              /* center of the 52px glyph */
      left: 50%;
      width: 68px;
      height: 68px;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      border: 1px solid var(--line);
      opacity: 0;
      transition: opacity 0.6s var(--ease), border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
      pointer-events: none;
    }
    :global(main.full-bleed.intro-done) .star-pull::before { opacity: 1; }
    .star:hover .star-pull::before,
    .star:focus-visible .star-pull::before {
      border-color: var(--accent-warm);
      box-shadow: 0 0 12px 0 var(--warm-soft), inset 0 0 10px 0 var(--warm-soft);
    }
    /* zoomed star: the ring would sit inside the orbit of sub-nodes, noise */
    .star.is-center .star-pull::before { opacity: 0; }

    /* one-time sonar ping rippling star to star when the rings switch on */
    .star-pull::after {
      content: '';
      position: absolute;
      top: 26px;
      left: 50%;
      width: 68px;
      height: 68px;
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(1);
      border: 1px solid var(--accent-warm);
      opacity: 0;
      pointer-events: none;
    }
    :global(main.full-bleed.ping-run) .star-pull::after {
      animation: star-ping 0.85s ease-out calc(var(--i, 0) * 0.13s) 1 both;
    }
    /* arrow impact: one ping on just the star that was hit */
    :global(main.full-bleed) .star.hit .star-pull::after {
      animation: star-ping 0.6s ease-out 1 both;
    }
    @keyframes star-ping {
      0%   { opacity: 0.7; transform: translate(-50%, -50%) scale(1); }
      100% { opacity: 0;   transform: translate(-50%, -50%) scale(1.9); }
    }
    .star-pull.zoom-transition { transition: transform 0.6s var(--ease); }

    .star-label {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg);
      transition: color 0.3s var(--ease);
    }
    .star-desc {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      color: var(--muted);
      white-space: nowrap;
      transition: color 0.3s var(--ease);
    }
    .enter-hint {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      color: var(--accent-warm);
      white-space: nowrap;
      opacity: 0;
      height: 0;
      transition: opacity 0.3s var(--ease) 0.2s;
    }
    .star.is-center .enter-hint { opacity: 1; height: auto; margin-top: 2px; }

    .star:hover .star-label,
    .star:focus-visible .star-label { color: var(--accent-warm); }
    .star:hover .star-desc,
    .star:focus-visible .star-desc { color: var(--fg); }
    .star:hover :global(.glyph),
    .star:focus-visible :global(.glyph) {
      filter: drop-shadow(0 0 8px var(--accent));
    }

    /* orbiting sub-nodes, revealed on zoom; JS pins each .orbit to its
       star's real measured position */
    .orbit {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 4;
      pointer-events: none;
    }
    .sub-node {
      position: absolute;
      top: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      width: 150px;
      margin-left: -75px;
      margin-top: -20px;
      text-align: center;
      opacity: 0;
      transform: rotate(var(--angle)) translate(var(--r)) rotate(calc(var(--angle) * -1)) scale(0.4);
      transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
      transition-delay: calc(var(--i) * 55ms);
      pointer-events: none;
    }
    .orbit.is-active .sub-node {
      opacity: 1;
      transform: rotate(var(--angle)) translate(var(--r)) rotate(calc(var(--angle) * -1)) scale(1);
      pointer-events: auto;
    }
    .sub-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--star);
      box-shadow: 0 0 6px 1px var(--accent);
    }
    .sub-label {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.04em;
      color: var(--fg);
      transition: color 0.25s var(--ease);
    }
    .sub-desc {
      font-family: var(--font-mono);
      font-size: 0.56rem;
      line-height: 1.4;
      color: var(--muted);
      max-width: 100%;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .sub-node:hover .sub-label,
    .sub-node:focus-visible .sub-label { color: var(--accent-warm); }

    /* zoom state */
    :global(main.full-bleed.zoomed) .hero-text {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
    }
    :global(main.full-bleed.zoomed) .line {
      opacity: 0;
    }
    :global(main.full-bleed.zoomed) .star.is-dim {
      opacity: 0 !important;
      pointer-events: none;
      transition: opacity 0.4s var(--ease);
    }
    .exit-void {
      position: fixed;
      bottom: 32px;
      left: 50%;
      transform: translate(-50%, 12px);
      z-index: 10;
      background: none;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 8px 16px;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
    }
    .exit-void:hover { color: var(--fg); border-color: var(--accent); }
    :global(main.full-bleed.zoomed) .exit-void {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }

    @media (max-width: 720px) {
      :global(main.full-bleed) {
        height: auto;
        overflow: visible;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      /* the field comes FIRST in the DOM (it has to, since the stars are absolutely
         positioned over the hero on desktop). on mobile everything goes static
         and flows in source order, which buried the name below the whole
         constellation. flex order puts the name back on top. */
      .hero-text { order: -1; }
      .field { order: 0; }

      .hero-text {
        position: static;
        padding: 96px 22px 4px;
        max-width: none;
      }
      .hero-text h1 { font-size: clamp(2.2rem, 12vw, 3rem); }
      .drift { margin: 14px 0 8px; }
      .lede { font-size: 0.94rem; }

      /* even two-column grid instead of inline-flex + margins, which wrapped
         unevenly and left a big dead gap under the last star */
      .field {
        position: static;
        transform: none !important;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px 10px;
        padding: 20px 16px 60px;
      }
      .zoom-scrim, .lines, .orbit, .exit-void { display: none; }
      .bow-grip, .bow-draw, .bow-arrow { display: none; }
      .star {
        position: static;
        transform: none;
        display: flex;
        margin: 0;
        padding: 4px;
        animation: none;
        opacity: 1;
      }
      /* five stars in a two-column grid leaves one alone on the last row,
         let it span both columns so it centers instead of hanging left */
      .star:last-of-type { grid-column: 1 / -1; }
      .star-label { font-size: 0.72rem; }
      .star-desc { white-space: normal; font-size: 0.62rem; line-height: 1.45; }
      .enter-hint { display: none; }
    }

    /* ---- shootable bowstring ---- */
    .bow-grip {
      position: absolute;
      height: 22px;
      z-index: 2;
      transform-origin: 0 50%;
      cursor: grab;
      pointer-events: none;   /* switched on by JS once the intro is done */
      touch-action: none;
    }
    :global(main.full-bleed.bow-enabled.intro-done) .bow-grip { pointer-events: auto; }
    :global(main.full-bleed.zoomed) .bow-grip { pointer-events: none; }
    .bow-grip:active { cursor: grabbing; }

    .bow-draw {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      overflow: visible;
      width: 100%;
      height: 100%;
    }
    .bow-draw path { fill: none; stroke: var(--accent-warm); stroke-width: 1; opacity: 0; }
    .bow-draw circle { fill: var(--star); opacity: 0; filter: drop-shadow(0 0 4px var(--accent-warm)); }
    :global(main.full-bleed.bow-drawing) .bow-draw path { opacity: 0.9; }
    :global(main.full-bleed.bow-drawing) .bow-draw circle { opacity: 1; }
    /* the straight string steps aside while the bent one is shown */
    :global(main.full-bleed.bow-drawing) .line.bowstring { opacity: 0; }

    .bow-arrow {
      position: absolute;
      left: 0;
      top: 0;
      width: 30px;
      height: 2px;
      z-index: 2;
      opacity: 0;
      border-radius: 2px;
      background: linear-gradient(to left, var(--star), transparent);
      filter: drop-shadow(0 0 5px var(--accent-warm));
      transform-origin: 100% 50%;
      pointer-events: none;
    }

    .lede-hint { font-size: 0.9em; opacity: 0.75; }

    @media (prefers-reduced-motion: reduce) {
      .bow-grip, .bow-draw, .bow-arrow { display: none; }
      .star { animation: none; opacity: 1; }
      .line-dot { display: none; }
      /* intro is skipped in JS too; this covers the pre-JS paint */
      .line { opacity: 0.45; }
      .star-pull::after { animation: none !important; }
      .line.lit { animation: none; }
      .star-pull.zoom-transition,
      .sub-node,
      .exit-void { transition-duration: 0.05s; }
    }
  </style>

  <script is:inline>
    (function () {
      var main = document.querySelector('main.full-bleed');
      var field = document.getElementById('field');
      var starEls = Array.prototype.slice.call(document.querySelectorAll('.star'));
      var lineEls = Array.prototype.slice.call(document.querySelectorAll('.line'));
      var exitBtn = document.querySelector('.exit-void');
      if (!main || !field || !starEls.length) return;

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var pointerFine = window.matchMedia('(pointer: fine)').matches;
      function isMobileLayout() { return window.matchMedia('(max-width: 720px)').matches; }

      // --- model ---------------------------------------------------------
      var stars = starEls.map(function (el) {
        return {
          el: el,
          pullEl: el.querySelector('.star-pull'),
          orbitEl: document.querySelector('.orbit[data-orbit="' + el.dataset.key + '"]'),
          idx: Number(el.dataset.idx),
          key: el.dataset.key,
          topPct: Number(el.dataset.top),
          leftPct: Number(el.dataset.left),
          hasChildren: el.dataset.hasChildren === 'true',
          baseX: 0, baseY: 0,
          cur: { x: 0, y: 0 },
          target: { x: 0, y: 0 },
          zoomState: false,
        };
      });
      var starsByKey = {};
      stars.forEach(function (s) { starsByKey[s.key] = s; });

      // fit the constellation's ACTUAL bounding box rather than a fixed
      // 100x100 square, since a bow is narrow and tall, so assuming a square
      // would shrink it to nothing on a wide monitor. reshaping the
      // constellation needs no change here; the box follows the stars.
      var bbox = (function () {
        var xs = stars.map(function (s) { return s.leftPct; });
        var ys = stars.map(function (s) { return s.topPct; });
        var minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
        var minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
        return {
          minX: minX, minY: minY,
          w: Math.max(maxX - minX, 1),
          h: Math.max(maxY - minY, 1),
        };
      })();

      var lines = lineEls.map(function (el) {
        // draw: 0 = not yet revealed, 1 = fully drawn. the intro walks this
        // from 0 to 1 one line at a time so the constellation assembles itself.
        return {
          el: el,
          a: Number(el.dataset.a),
          b: Number(el.dataset.b),
          draw: 0,
          isBow: el.classList.contains('bowstring'),
        };
      });
      var bowGripEl = document.getElementById('bowGrip');

      // bow flex: while the string is drawn, the whole limb bends. tips
      // (research, connect) travel furthest; the grip star (projects, the
      // middle) barely moves, like a real bow bending around its riser.
      var bowFlex = { x: 0, y: 0 };
      var FLEX_W = [1, 0.6, 0.3, 0.6, 1];
      function flexX(s) { return s.zoomState ? 0 : bowFlex.x * (FLEX_W[s.idx] || 0); }
      function flexY(s) { return s.zoomState ? 0 : bowFlex.y * (FLEX_W[s.idx] || 0); }


      var zoomedKey = null;

      var fieldRect = { w: 1, h: 1, left: 0, top: 0 };
      function measure() {
        var r = field.getBoundingClientRect();
        fieldRect.w = r.width || 1;
        fieldRect.h = r.height || 1;
        fieldRect.left = r.left;
        fieldRect.top = r.top;

        // uniform-scale letterbox: the constellation lives in a fixed
        // 100x100 design space, scaled by the SAME factor in both axes and
        // centered in whatever room is left after padding. the shape is
        // therefore identical on every monitor (wide, tall, square); the
        // whole thing just gets bigger or smaller.
        // pixel margins leave room for the labels that hang below and beside
        // each star, so nothing gets clipped at the edges
        var padTop = 175, padBottom = 100, padSide = 90;
        var padLeft = fieldRect.w >= 1000 ? 460 : padSide; // clear the hero text on wide screens
        var availW = Math.max(fieldRect.w - padLeft - padSide, 120);
        var availH = Math.max(fieldRect.h - padTop - padBottom, 120);
        // ONE scale factor for both axes, which is what keeps the shape
        // identical on ultrawide, 16:9, square, and portrait screens
        var scale = Math.min(availW / bbox.w, availH / bbox.h, 14);
        var offsetX = padLeft + (availW - bbox.w * scale) / 2;
        var offsetY = padTop + (availH - bbox.h * scale) / 2;

        // sub-orbit radius shrinks on small windows so the ring always fits
        var maxRing = Math.max(120, Math.min(fieldRect.w, fieldRect.h) / 2 - 110);

        var mobile = isMobileLayout();
        stars.forEach(function (s) {
          s.baseX = offsetX + (s.leftPct - bbox.minX) * scale;
          s.baseY = offsetY + (s.topPct - bbox.minY) * scale;
          // the anchor is the center of the whole column (glyph + label +
          // desc), but the visual star is the glyph at the top. lines, rings,
          // and pings should all meet at the glyph's center, 26px from the
          // column top.
          var colH = s.el.offsetHeight || 52;
          s.nodeDY = 26 - colH / 2;
          if (mobile) {
            s.el.style.left = '';
            s.el.style.top = '';
          } else {
            s.el.style.left = s.baseX + 'px';
            s.el.style.top = s.baseY + 'px';
          }
          if (s.orbitEl) {
            s.orbitEl.style.left = s.baseX + 'px';
            s.orbitEl.style.top = s.baseY + 'px';
            var baseR = Number(s.orbitEl.dataset.radius) || 180;
            s.orbitEl.style.setProperty('--r', Math.min(baseR, maxRing) + 'px');
          }
        });

        // if a star is zoomed while the window resizes, re-center it
        if (zoomedKey) {
          var z = starsByKey[zoomedKey];
          var zdx = fieldRect.w / 2 - z.baseX;
          var zdy = fieldRect.h / 2 - z.baseY;
          if (z.pullEl) z.pullEl.style.transform = 'translate(' + zdx + 'px,' + zdy + 'px) scale(1.6)';
          if (z.orbitEl) z.orbitEl.style.transform = 'translate(' + zdx + 'px,' + zdy + 'px)';
        }
      }

      // position one line between two stars' current pixel positions
      function layLine(line) {
        var a = stars[line.a], b = stars[line.b];
        var ax = a.baseX + flexX(a) + (a.zoomState ? 0 : a.cur.x);
        var ay = a.baseY + (a.nodeDY || 0) + flexY(a) + (a.zoomState ? 0 : a.cur.y);
        var bx = b.baseX + flexX(b) + (b.zoomState ? 0 : b.cur.x);
        var by = b.baseY + (b.nodeDY || 0) + flexY(b) + (b.zoomState ? 0 : b.cur.y);
        var dx = bx - ax, dy = by - ay;
        var len = Math.hypot(dx, dy);
        var ang = Math.atan2(dy, dx) * 180 / Math.PI;
        // `draw` is the intro reveal (0 to 1). folding it in here rather than
        // animating width directly means the per-frame tension relayout can't
        // stomp on the animation, and vice versa.
        line.el.style.left = ax + 'px';
        line.el.style.top = ay + 'px';
        line.el.style.width = (len * line.draw) + 'px';
        line.el.style.transform = 'rotate(' + ang + 'deg)';
        // the invisible grab strip rides along the bowstring
        if (line.isBow && bowGripEl) {
          bowGripEl.style.left = ax + 'px';
          bowGripEl.style.top = (ay - 11) + 'px';
          bowGripEl.style.width = (len * line.draw) + 'px';
          bowGripEl.style.transform = 'rotate(' + ang + 'deg)';
        }
      }
      function layAllLines() { lines.forEach(layLine); }

      measure();
      layAllLines();
      window.addEventListener('resize', function () {
        // crossing the mobile breakpoint mid-intro would strand half-drawn
        // lines, so settle the constellation immediately if that happens
        if (isMobileLayout()) finishIntro();
        measure();
        layAllLines();
      });

      // --- intro: stars twinkle in, then the lines draw between them -------
      // the stars' own entrance is CSS (staggered .star animation-delay); this
      // picks up where that leaves off and draws the limb star to star, so the
      // shape assembles itself instead of just appearing.
      var BOOT_DELAY   = 600;   // ms of quiet before the first star appears
      var STAR_STAGGER = 280;   // ms between each star twinkling in (sequential)
      var LINE_STAGGER = 150;   // ms between each line starting to draw
      var LINE_DUR     = 420;   // ms for one line to draw fully
      // measured from boot: lines begin as the last star is landing
      var LINE_START   = starEls.length * STAR_STAGGER - 250;

      function finishIntro() {
        lines.forEach(function (l) { l.draw = 1; });
        layAllLines();
        if (main) {
          main.classList.add('intro-done');
          // the intro ping plays once under its own class; removing the
          // class afterwards means re-triggering a ping later (arrow hits)
          // can't accidentally replay the full intro ripple
          main.classList.add('ping-run');
          setTimeout(function () { main.classList.remove('ping-run'); }, 3000);
        }
      }

      function runIntro() {
        // mobile is a flat grid with the lines hidden, so there is nothing to draw
        if (reduceMotion || isMobileLayout()) { finishIntro(); return; }

        var t0 = null;
        function frame(ts) {
          if (t0 === null) t0 = ts;
          var elapsed = ts - t0;
          var allDone = true;
          for (var i = 0; i < lines.length; i++) {
            var startAt = LINE_START + i * LINE_STAGGER;
            var p = (elapsed - startAt) / LINE_DUR;
            p = p < 0 ? 0 : p > 1 ? 1 : p;
            // ease-out cubic: quick off the mark, settles into the star
            lines[i].draw = 1 - Math.pow(1 - p, 3);
            if (p < 1) allDone = false;
          }
          layAllLines();
          if (allDone) { finishIntro(); return; }
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      }
      // boot after a beat of stillness: two rAFs guarantee a real painted
      // frame first, so star one is never eaten by page-load jank
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          setTimeout(function () {
            if (main) main.classList.add('booted');
            runIntro();
          }, BOOT_DELAY);
        });
      });

      // --- line illumination (works regardless of motion prefs) ----------
      stars.forEach(function (s) {
        s.el.addEventListener('mouseenter', function () {
          lines.forEach(function (l) {
            if (l.a === s.idx || l.b === s.idx) l.el.classList.add('lit');
          });
        });
        s.el.addEventListener('mouseleave', function () {
          lines.forEach(function (l) { l.el.classList.remove('lit'); });
        });
      });

      // --- gravitational pull + parallax (fine pointers, motion ok) ------
      var mouse = { x: -9999, y: -9999, inside: false };
      var drift = { x: 0, y: 0 };
      var targetDrift = { x: 0, y: 0 };
      var PULL_RADIUS = 170;
      var PULL_MAX = 20;
      var DRIFT_MAX = 16;

      if (!reduceMotion && pointerFine && !isMobileLayout()) {
        window.addEventListener('mousemove', function (e) {
          mouse.x = e.clientX - fieldRect.left;
          mouse.y = e.clientY - fieldRect.top;
          mouse.inside = true;
          targetDrift.x = (e.clientX / window.innerWidth - 0.5) * DRIFT_MAX;
          targetDrift.y = (e.clientY / window.innerHeight - 0.5) * DRIFT_MAX;
        }, { passive: true });
        document.documentElement.addEventListener('mouseleave', function () { mouse.inside = false; });

        function tick() {
          drift.x += (targetDrift.x - drift.x) * 0.08;
          drift.y += (targetDrift.y - drift.y) * 0.08;
          field.style.transform = 'translate(' + drift.x.toFixed(2) + 'px,' + drift.y.toFixed(2) + 'px)';

          stars.forEach(function (s) {
            if (s.zoomState) return; // zoom owns this star's transform
            var dx = mouse.x - s.baseX;
            var dy = mouse.y - s.baseY;
            var dist = Math.hypot(dx, dy);
            if (mouse.inside && dist < PULL_RADIUS && dist > 0.01) {
              var t = 1 - dist / PULL_RADIUS;
              s.target.x = (dx / dist) * PULL_MAX * t;
              s.target.y = (dy / dist) * PULL_MAX * t;
            } else {
              s.target.x = 0;
              s.target.y = 0;
            }
            s.cur.x += (s.target.x - s.cur.x) * 0.15;
            s.cur.y += (s.target.y - s.cur.y) * 0.15;
            if (s.pullEl) s.pullEl.style.transform = 'translate(' + (s.cur.x + flexX(s)).toFixed(2) + 'px,' + (s.cur.y + flexY(s)).toFixed(2) + 'px)';
          });

          layAllLines(); // lines follow the pulled stars, the "tension"
          requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

      // --- click-to-zoom expansion ---------------------------------------
      function enterZoom(star) {
        zoomedKey = star.key;
        star.zoomState = true;
        star.cur = { x: 0, y: 0 };
        main.classList.add('zoomed');
        star.el.classList.add('is-center');
        stars.forEach(function (s) { if (s !== star) s.el.classList.add('is-dim'); });

        var dx = fieldRect.w / 2 - star.baseX;
        var dy = fieldRect.h / 2 - star.baseY;

        if (star.pullEl) {
          star.pullEl.classList.add('zoom-transition');
          star.pullEl.style.transform = 'translate(' + dx + 'px,' + dy + 'px) scale(1.6)';
        }
        if (star.orbitEl) {
          star.orbitEl.style.transition = 'transform 0.6s var(--ease)';
          star.orbitEl.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
          star.orbitEl.classList.add('is-active');
          star.orbitEl.querySelectorAll('.sub-node').forEach(function (n) { n.removeAttribute('tabindex'); });
        }
      }

      function exitZoom() {
        if (!zoomedKey) return;
        var star = starsByKey[zoomedKey];
        main.classList.remove('zoomed');
        star.el.classList.remove('is-center');
        stars.forEach(function (s) { s.el.classList.remove('is-dim'); });

        if (star.pullEl) star.pullEl.style.transform = 'translate(0px,0px) scale(1)';
        if (star.orbitEl) {
          star.orbitEl.style.transform = 'translate(0px,0px)';
          star.orbitEl.classList.remove('is-active');
          star.orbitEl.querySelectorAll('.sub-node').forEach(function (n) { n.setAttribute('tabindex', '-1'); });
        }
        var doneKey = zoomedKey;
        zoomedKey = null;
        setTimeout(function () {
          var s = starsByKey[doneKey];
          s.zoomState = false;
          if (s.pullEl) s.pullEl.classList.remove('zoom-transition');
        }, 650);
      }

      stars.forEach(function (star) {
        star.el.addEventListener('click', function (e) {
          if (isMobileLayout()) return; // flat mobile layout, default nav
          if (!star.hasChildren) return; // nothing to expand, go to page
          if (zoomedKey === star.key) return; // second click commits to page
          e.preventDefault();
          if (zoomedKey) exitZoom();
          enterZoom(star);
        });
      });

      exitBtn.addEventListener('click', exitZoom);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') exitZoom();
      });
      main.addEventListener('click', function (e) {
        if (!zoomedKey) return;
        if (e.target.closest('.star, .sub-node, .exit-void')) return;
        exitZoom();
      });
      // --- shootable bow ---------------------------------------------------
      // grab the bowstring, pull, release: the string bends into a V and an
      // arrow flies to a random star and opens it. shoot the bow, go somewhere.
      (function () {
        if (reduceMotion || isMobileLayout()) return;
        var grip = document.getElementById('bowGrip');
        var drawPath = document.getElementById('bowDrawPath');
        var nock = document.getElementById('bowNock');
        var arrow = document.getElementById('bowArrow');
        var bowLine = null;
        for (var i = 0; i < lines.length; i++) if (lines[i].isBow) bowLine = lines[i];
        if (!grip || !drawPath || !nock || !arrow || !bowLine) return;
        main.classList.add('bow-enabled');

        var drawing = false, firing = false, grab = { x: 0, y: 0 };
        var grab0 = { x: 0, y: 0 };   // where the string was first grabbed
        var MAX_PULL = 240;   // px: how far the string can stretch
        var MIN_FIRE = 40;    // px: pulls shorter than this just relax

        function nodePoint(s) {
          return {
            x: s.baseX + flexX(s) + (s.zoomState ? 0 : s.cur.x),
            y: s.baseY + (s.nodeDY || 0) + flexY(s) + (s.zoomState ? 0 : s.cur.y),
          };
        }
        function stringEnds() { return { A: nodePoint(stars[bowLine.a]), B: nodePoint(stars[bowLine.b]) }; }
        function stringMid() {
          var ep = stringEnds();
          return { x: (ep.A.x + ep.B.x) / 2, y: (ep.A.y + ep.B.y) / 2 };
        }
        function fieldPos(e) {
          // live rect: the field translates with the parallax drift
          var r = field.getBoundingClientRect();
          return { x: e.clientX - r.left, y: e.clientY - r.top };
        }
        function renderString() {
          var ep = stringEnds();
          drawPath.setAttribute('d',
            'M ' + ep.A.x + ' ' + ep.A.y +
            ' L ' + grab.x + ' ' + grab.y +
            ' L ' + ep.B.x + ' ' + ep.B.y);
          nock.setAttribute('cx', grab.x);
          nock.setAttribute('cy', grab.y);
        }

        grip.addEventListener('pointerdown', function (e) {
          if (zoomedKey || firing || !main.classList.contains('intro-done')) return;
          e.preventDefault();
          drawing = true;
          grab = fieldPos(e);
          grab0 = { x: grab.x, y: grab.y };
          main.classList.add('bow-drawing');
          renderString();
          if (grip.setPointerCapture && e.pointerId !== undefined) {
            try { grip.setPointerCapture(e.pointerId); } catch (err) {}
          }
        });

        window.addEventListener('pointermove', function (e) {
          if (!drawing) return;
          var p = fieldPos(e);
          // clamp relative to where the string was grabbed, not its midpoint,
          // so grabbing near an end doesn't snap the nock across the screen
          var dx = p.x - grab0.x, dy = p.y - grab0.y;
          var d = Math.hypot(dx, dy);
          if (d > MAX_PULL) { dx *= MAX_PULL / d; dy *= MAX_PULL / d; }
          grab = { x: grab0.x + dx, y: grab0.y + dy };
          // the limb bends with the draw: a fraction of the pull displacement,
          // scaled per star by FLEX_W in the render loop
          bowFlex.x = dx * 0.38;
          bowFlex.y = dy * 0.38;
          renderString();
        });

        // the snap: after release the limb doesn't glide back, it whips past
        // rest and rings down. damped oscillation on the flex vector.
        function springBack() {
          var fx = bowFlex.x, fy = bowFlex.y;
          if (Math.hypot(fx, fy) < 0.5) { bowFlex.x = 0; bowFlex.y = 0; return; }
          var t0 = null;
          function step(ts) {
            if (t0 === null) t0 = ts;
            var t = (ts - t0) / 1000;
            var k = Math.exp(-t * 7) * Math.cos(t * 2 * Math.PI * 3.4);
            bowFlex.x = fx * k;
            bowFlex.y = fy * k;
            if (t < 0.7) { requestAnimationFrame(step); return; }
            bowFlex.x = 0; bowFlex.y = 0;
          }
          requestAnimationFrame(step);
        }

        window.addEventListener('pointerup', function () {
          if (!drawing) return;
          drawing = false;
          main.classList.remove('bow-drawing');
          // fire only on an actual drag: displacement from the grab point,
          // so a bare click on the string can never loose an arrow
          var pull = Math.hypot(grab.x - grab0.x, grab.y - grab0.y);
          springBack();
          if (pull >= MIN_FIRE) fire(stringMid());
        });

        // a resize mid-draw would leave the bent string aimed at stale
        // coordinates: relax instead
        window.addEventListener('resize', function () {
          if (!drawing) return;
          drawing = false;
          main.classList.remove('bow-drawing');
          bowFlex.x = 0; bowFlex.y = 0;
        });

        function fire(mid) {
          firing = true;
          // launch direction: opposite the pull, through the string's rest line
          var dirx = mid.x - grab.x, diry = mid.y - grab.y;
          var dl = Math.hypot(dirx, diry) || 1;
          dirx /= dl; diry /= dl;

          var target = stars[Math.floor(Math.random() * stars.length)];
          var T = nodePoint(target);

          // quadratic bezier: leaves along the aim direction, curves to the star
          var P0 = { x: grab.x, y: grab.y };
          var dist = Math.hypot(T.x - P0.x, T.y - P0.y);
          var lead = Math.min(240, dist * 0.5);
          var P1 = { x: P0.x + dirx * lead, y: P0.y + diry * lead };

          var DUR = 560, t0 = null;
          arrow.style.opacity = '1';
          function step(ts) {
            if (t0 === null) t0 = ts;
            var p = Math.min(1, (ts - t0) / DUR);
            var ez = 1 - Math.pow(1 - p, 2); // ease-out: fast off the string
            var u = 1 - ez;
            var x = u * u * P0.x + 2 * u * ez * P1.x + ez * ez * T.x;
            var y = u * u * P0.y + 2 * u * ez * P1.y + ez * ez * T.y;
            var vx = 2 * u * (P1.x - P0.x) + 2 * ez * (T.x - P1.x);
            var vy = 2 * u * (P1.y - P0.y) + 2 * ez * (T.y - P1.y);
            var ang = Math.atan2(vy, vx) * 180 / Math.PI;
            // the div's right end is the arrowhead; pivot there
            arrow.style.transform =
              'translate(' + (x - 30) + 'px,' + (y - 1) + 'px) rotate(' + ang + 'deg)';
            if (p < 1) { requestAnimationFrame(step); return; }
            arrow.style.opacity = '0';
            // impact ping on the star it found, then open it
            target.el.classList.remove('hit');
            void target.el.offsetWidth;
            target.el.classList.add('hit');
            setTimeout(function () { target.el.classList.remove('hit'); }, 700);
            setTimeout(function () {
              target.el.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
              firing = false;
            }, 180);
          }
          requestAnimationFrame(step);
        }

        // hovering the string lights it, hinting it can be grabbed
        grip.addEventListener('mouseenter', function () {
          if (!zoomedKey) bowLine.el.classList.add('lit');
        });
        grip.addEventListener('mouseleave', function () {
          if (!drawing) bowLine.el.classList.remove('lit');
        });
      })();
    })();
  </script>
</SystemLayout>
