---
import '../styles/theme.css';
import Starfield from '../components/Starfield.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  fullBleed?: boolean;
}

// absolute origin. link previews (discord, imessage, slack, twitter) all
// REQUIRE an absolute og:image url; a relative path renders as a grey box.
const SITE = 'https://abirdeol.tech';
const {
  title,
  description = 'systems programmer at the university of alberta. 15 projects built raw: distributed systems, allocators, virtual machines, raytracers.',
  fullBleed = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = `${SITE}/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#070b12" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="abir deol / apollo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="abir deol / apollo, constellation portfolio" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // set theme before first paint, so there is no flash of wrong theme, works on every page
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('portfolio-theme'); } catch (e) {}
        if (!saved) {
          // fallback for environments that block localStorage (sandboxed
          // preview iframes, private browsing), so read the cookie mirror instead
          var match = document.cookie.match(/(?:^|; )portfolio-theme=([^;]+)/);
          if (match) saved = decodeURIComponent(match[1]);
        }
        document.documentElement.setAttribute('data-theme', saved || 'orbit');
      })();
    </script>
  </head>
  <body>
    <div id="boot" aria-hidden="true">
      <span>apollo uplink :: establishing signal<span class="dots">...</span></span>
    </div>

    <Starfield />
    <div class="apollo" title="apollo" aria-hidden="true"></div>

    <header class="site-header">
      <div class="header-left">
      <a href="/" class="wordmark">
        <svg class="lyre-mark" viewBox="0 0 24 24" width="15" height="16" aria-hidden="true">
          <path d="M5.5 21V11C5.5 6.5 7.3 3.4 9.6 2.4" />
          <path d="M18.5 21V11C18.5 6.5 16.7 3.4 14.4 2.4" />
          <line x1="5.5" y1="21" x2="18.5" y2="21" />
          <line x1="8.4" y1="10.5" x2="8.4" y2="19.2" />
          <line x1="10.8" y1="9.6" x2="10.8" y2="19.2" />
          <line x1="13.2" y1="9.6" x2="13.2" y2="19.2" />
          <line x1="15.6" y1="10.5" x2="15.6" y2="19.2" />
        </svg>
        abir deol / apollo
      </a>

      <span class="header-sep" aria-hidden="true"></span>

      <a
        class="resume-link"
        href="/abir-deol-resume.pdf"
        target="_blank"
        rel="noopener"
        title="open resume (pdf)"
      >
        <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
          <path d="M6 2.5h8l4 4V21a.5.5 0 0 1-.5.5h-11A.5.5 0 0 1 6 21V3a.5.5 0 0 1 .5-.5Z" />
          <path d="M14 2.5V7h4" />
          <line x1="9" y1="12" x2="15" y2="12" />
          <line x1="9" y1="16" x2="13" y2="16" />
        </svg>
        resume
      </a>
      </div>
      <ThemeToggle />
    </header>

    <main class={fullBleed ? 'full-bleed' : ''}>
      <slot />
    </main>

    <style>
      /* without a backdrop, page content scrolls straight through the fixed
         header and collides with the wordmark. this fades the background out
         below the header instead of drawing a hard bar across the starfield. */
      .site-header::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: calc(100% + 34px);
        z-index: -1;
        pointer-events: none;
        background: linear-gradient(
          to bottom,
          rgb(var(--bg-rgb)) 0%,
          rgb(var(--bg-rgb)) 52%,
          rgba(var(--bg-rgb), 0.82) 74%,
          rgba(var(--bg-rgb), 0) 100%
        );
      }
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 20;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px clamp(20px, 4vw, 48px);
        pointer-events: none;
      }
      .site-header > * { pointer-events: auto; }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-family: var(--font-mono);
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: lowercase;
        color: var(--fg);
      }
      .wordmark:hover { color: var(--accent); }

      .header-left {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        pointer-events: auto;
        min-width: 0;
      }
      .header-sep {
        width: 1px;
        height: 15px;
        background: var(--line);
        flex: none;
      }
      /* resume sits beside the name, deliberately outside the constellation */
      .resume-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex: none;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.07em;
        color: var(--muted);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 11px 4px 9px;
        transition:
          color 0.25s var(--ease),
          border-color 0.25s var(--ease),
          background 0.25s var(--ease);
      }
      .resume-link svg {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .resume-link:hover,
      .resume-link:focus-visible {
        color: var(--fg);
        border-color: var(--accent-edge);
        background: var(--accent-soft);
      }
      .lyre-mark {
        stroke: var(--accent-warm);
        stroke-width: 1.4;
        stroke-linecap: round;
        fill: none;
      }

      .apollo {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 2;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent-warm);
        box-shadow: 0 0 16px 4px var(--accent-warm), 0 0 40px 10px var(--accent-warm);
        opacity: 0;
        pointer-events: none;
        animation: apollo-arc 46s linear infinite;
      }
      @keyframes apollo-arc {
        0%   { transform: translate(-8vw, 22vh) scale(0.7); opacity: 0; }
        6%   { opacity: 0.9; }
        50%  { transform: translate(52vw, -6vh) scale(1); opacity: 1; }
        94%  { opacity: 0.9; }
        100% { transform: translate(112vw, 22vh) scale(0.7); opacity: 0; }
      }
      @media (max-width: 720px) {
        .site-header { padding: 15px 14px; }
        .wordmark { font-size: 0.76rem; letter-spacing: 0.04em; gap: 6px; }
        .lyre-mark { width: 12px; height: 13px; }
        .header-left { gap: 8px; }
        .header-sep { height: 13px; }
        .resume-link { font-size: 0.64rem; padding: 3px 8px 3px 7px; gap: 4px; }
        .resume-link svg { width: 10px; height: 10px; }
      }
      /* very narrow phones: drop the icon, keep the label */
      @media (max-width: 400px) {
        .resume-link svg { display: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        .apollo { animation: none; opacity: 0.6; top: 6vh; left: 50vw; }
      }

      main {
        position: relative;
        z-index: 5;
        max-width: var(--content-w);
        margin: 0 auto;
        padding: 140px clamp(20px, 6vw, 48px) 160px;
        min-height: 100vh;
      }
      main.full-bleed {
        max-width: none;
        margin: 0;
        padding: 0;
        height: 100vh;
        overflow: hidden;
      }

      #boot {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: var(--bg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--muted);
        animation: boot-out 0.6s ease 0.7s forwards;
        pointer-events: none;
      }
      .dots { display: inline-block; width: 1.4em; text-align: left; }
      @keyframes boot-out {
        to { opacity: 0; visibility: hidden; }
      }
      @media (prefers-reduced-motion: reduce) {
        #boot { animation: none; opacity: 0; visibility: hidden; }
      }
    </style>
  </body>
</html>
