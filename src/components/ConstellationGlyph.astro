---
interface Props {
  variant: 'work' | 'projects' | 'research' | 'passions' | 'transmissions' | 'connect';
  size?: number;
}
const { variant, size = 64 } = Astro.props;
---

<svg class="glyph" viewBox="0 0 100 100" width={size} height={size} aria-hidden="true">
  {variant === 'work' && (
    <g>
      <line x1="50" y1="18" x2="20" y2="78" />
      <line x1="50" y1="18" x2="80" y2="78" />
      <line x1="20" y1="78" x2="80" y2="78" />
      <circle cx="50" cy="18" r="3.5" />
      <circle cx="20" cy="78" r="3.5" />
      <circle cx="80" cy="78" r="3.5" />
    </g>
  )}
  {variant === 'projects' && (
    <g>
      <line x1="50" y1="14" x2="86" y2="50" />
      <line x1="86" y1="50" x2="50" y2="86" />
      <line x1="50" y1="86" x2="14" y2="50" />
      <line x1="14" y1="50" x2="50" y2="14" />
      <line x1="50" y1="14" x2="50" y2="86" />
      <circle cx="50" cy="14" r="3.5" />
      <circle cx="86" cy="50" r="3" />
      <circle cx="50" cy="86" r="3" />
      <circle cx="14" cy="50" r="3" />
    </g>
  )}
  {variant === 'research' && (
    <g>
      <circle cx="50" cy="50" r="3" />
      <circle cx="50" cy="50" r="16" fill="none" stroke-dasharray="2 5" />
      <circle cx="50" cy="50" r="30" fill="none" stroke-dasharray="1 7" opacity="0.5" />
    </g>
  )}
  {variant === 'passions' && (
    <g>
      <line x1="38" y1="50" x2="66" y2="38" />
      <circle cx="38" cy="50" r="5" />
      <circle cx="66" cy="38" r="3" />
      <circle cx="66" cy="38" r="12" fill="none" opacity="0.35" />
    </g>
  )}
  {variant === 'transmissions' && (
    <g>
      <circle cx="50" cy="50" r="3.5" />
      <line x1="50" y1="50" x2="50" y2="20" />
      <line x1="50" y1="50" x2="76" y2="34" />
      <line x1="50" y1="50" x2="80" y2="60" />
      <line x1="50" y1="50" x2="30" y2="78" />
      <circle cx="50" cy="20" r="2" />
      <circle cx="76" cy="34" r="2" />
      <circle cx="80" cy="60" r="2" />
      <circle cx="30" cy="78" r="2" />
    </g>
  )}
  {variant === 'connect' && (
    <g>
      <circle cx="50" cy="50" r="4.5" />
      <circle cx="50" cy="50" r="18" fill="none" opacity="0.5" />
      <circle cx="50" cy="50" r="32" fill="none" opacity="0.25" />
    </g>
  )}
</svg>

<style>
  .glyph {
    overflow: visible;
    stroke: var(--accent);
    stroke-width: 1;
    fill: none;
  }
  .glyph circle {
    fill: var(--star);
    stroke: none;
  }
  .glyph circle[fill='none'] {
    fill: none;
    stroke: var(--accent);
  }
</style>
