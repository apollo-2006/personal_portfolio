---
---
<canvas id="starfield" aria-hidden="true"></canvas>

<style>
  #starfield {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    background: var(--bg);
  }
</style>

<script is:inline>
  (function () {
    var canvas = document.getElementById('starfield');
    var ctx = canvas.getContext('2d');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var width = 0, height = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener('resize', function () {
      resize();
      if (typeof buildDeepField === 'function') buildDeepField();
    });

    function Star() {
      this.reset();
    }
    Star.prototype.reset = function () {
      this.x = (Math.random() - 0.5) * width * 2;
      this.y = (Math.random() - 0.5) * height * 2;
      this.z = Math.random() * width;
      this.pz = this.z;
    };
    Star.prototype.update = function (speed) {
      this.z -= speed;
      if (this.z < 1) {
        this.reset();
        this.z = width;
        this.pz = this.z;
      }
    };
    Star.prototype.draw = function (cx, cy, drift, starColor) {
      var sx = (this.x / this.z) * width + cx + drift.x;
      var sy = (this.y / this.z) * width + cy + drift.y;
      var px = (this.x / this.pz) * width + cx + drift.x;
      var py = (this.y / this.pz) * width + cy + drift.y;
      this.pz = this.z;

      if (sx < -50 || sx > width + 50 || sy < -50 || sy > height + 50) return;

      var size = Math.max(0.4, (1 - this.z / width) * 2.2);
      ctx.strokeStyle = starColor;
      ctx.globalAlpha = Math.min(1, (1 - this.z / width) * 1.4);
      ctx.lineWidth = size;
      ctx.beginPath();
      ctx.moveTo(px, py);
      ctx.lineTo(sx, sy);
      ctx.stroke();
    };

    var starCount = reduceMotion ? 400 : 1100;
    var stars = [];
    for (var i = 0; i < starCount; i++) stars.push(new Star());

    // static deep field: distant stars that don't fly past, just sit there
    // and breathe. this is what makes the void feel populated instead of
    // like a screensaver of streaks.
    var deepField = [];
    function buildDeepField() {
      deepField.length = 0;
      var count = Math.round((width * height) / 5200);
      count = Math.max(260, Math.min(count, reduceMotion ? 500 : 1500));
      for (var i = 0; i < count; i++) {
        deepField.push({
          x: Math.random() * width,
          y: Math.random() * height,
          r: Math.random() < 0.86 ? Math.random() * 0.7 + 0.25 : Math.random() * 1.1 + 0.9,
          base: Math.random() * 0.45 + 0.12,
          amp: Math.random() * 0.3,
          phase: Math.random() * Math.PI * 2,
          speed: Math.random() * 0.0011 + 0.0004,
          // parallax factor: nearer stars shift more with the cursor
          depth: Math.random() * 0.5 + 0.1,
        });
      }
    }
    buildDeepField();

    function drawDeepField(t, drift, starColor) {
      for (var i = 0; i < deepField.length; i++) {
        var s = deepField[i];
        var tw = s.base + Math.sin(t * s.speed + s.phase) * s.amp;
        if (tw <= 0.01) continue;
        ctx.globalAlpha = tw;
        ctx.fillStyle = starColor;
        ctx.beginPath();
        ctx.arc(s.x + drift.x * s.depth, s.y + drift.y * s.depth, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    var baseSpeed = reduceMotion ? 0.15 : 0.35;
    var targetSpeed = baseSpeed;
    var currentSpeed = baseSpeed;

    var lastScrollY = window.scrollY;
    var lastScrollT = performance.now();
    window.addEventListener('scroll', function () {
      var now = performance.now();
      var dt = Math.max(16, now - lastScrollT);
      var dy = Math.abs(window.scrollY - lastScrollY);
      var velocity = dy / dt;
      targetSpeed = baseSpeed + Math.min(velocity * 12, reduceMotion ? 0 : 6);
      lastScrollY = window.scrollY;
      lastScrollT = now;
    }, { passive: true });

    var drift = { x: 0, y: 0 };
    var targetDrift = { x: 0, y: 0 };
    if (!reduceMotion) {
      window.addEventListener('mousemove', function (e) {
        targetDrift.x = (e.clientX / width - 0.5) * -30;
        targetDrift.y = (e.clientY / height - 0.5) * -30;
      });
    }

    var shootingStars = [];
    function maybeSpawnShootingStar() {
      if (reduceMotion) return;
      if (Math.random() < 0.006 && shootingStars.length < 2) {
        var startX = Math.random() * width * 0.6 + width * 0.1;
        var startY = Math.random() * height * 0.3;
        var angle = Math.PI / 4 + (Math.random() - 0.5) * 0.4;
        var speed = 9 + Math.random() * 6;
        shootingStars.push({
          x: startX, y: startY,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          life: 1,
        });
      }
    }
    function updateShootingStars(starColor) {
      for (var i = shootingStars.length - 1; i >= 0; i--) {
        var s = shootingStars[i];
        var prevX = s.x, prevY = s.y;
        s.x += s.vx;
        s.y += s.vy;
        s.life -= 0.02;
        if (s.life <= 0 || s.x > width + 50 || s.y > height + 50) {
          shootingStars.splice(i, 1);
          continue;
        }
        var grad = ctx.createLinearGradient(prevX, prevY, s.x, s.y);
        grad.addColorStop(0, 'rgba(0,0,0,0)');
        grad.addColorStop(1, starColor);
        ctx.strokeStyle = grad;
        ctx.globalAlpha = Math.max(0, s.life);
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.moveTo(prevX, prevY);
        ctx.lineTo(s.x, s.y);
        ctx.stroke();
      }
    }

    function frame() {
      targetSpeed += (baseSpeed - targetSpeed) * 0.02;
      currentSpeed += (targetSpeed - currentSpeed) * 0.06;
      drift.x += (targetDrift.x - drift.x) * 0.03;
      drift.y += (targetDrift.y - drift.y) * 0.03;

      var starColor = getComputedStyle(document.documentElement).getPropertyValue('--star') || '#fff';
      starColor = starColor.trim();
      ctx.clearRect(0, 0, width, height);
      drawDeepField(performance.now(), drift, starColor);
      var cx = width / 2, cy = height / 2;
      for (var i = 0; i < stars.length; i++) {
        stars[i].update(currentSpeed);
        stars[i].draw(cx, cy, drift, starColor);
      }
      ctx.globalAlpha = 1;
      maybeSpawnShootingStar();
      updateShootingStars(starColor);
      ctx.globalAlpha = 1;
      requestAnimationFrame(frame);
    }
    frame();
  })();
</script>
